# Copy to .env.local for development. In production, set these in Vercel's
# Project Settings > Environment Variables instead.

# From Vercel's integrated Postgres (or any Postgres provider)
DATABASE_URL=postgres://user:password@host:5432/dbname

# A long random string - used to sign session tokens. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Your app's URL - http://localhost:3000 for local dev
BETTER_AUTH_URL=http://localhost:3000

# From resend.com - used to send password reset emails
RESEND_API_KEY=

# Used once by `npm run db:seed` to create your very first login.
# Safe to remove from .env.local after the first successful seed.
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=change-this-before-seeding
